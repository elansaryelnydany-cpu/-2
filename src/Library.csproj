<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ElansaryWordLibrary</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);ElansaryWordLibrary/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../legacy-reader/PatchedHwpf.csproj"/>
    <PackageReference Include="NPOI" Version="2.4.1"/>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0"/>
  </ItemGroup>
</Project>
